# Copie este arquivo para ".env" e ajuste os valores.
# NODE_ENV=production exige APP_SENHA e JWT_SECRET definidos.
NODE_ENV=development
PORT=3001
# 127.0.0.1 = só este computador. Use 0.0.0.0 para acessar de outros aparelhos da loja (Wi-Fi).
HOST=127.0.0.1
# Senha de acesso ao sistema (troque!)
APP_SENHA=troque-esta-senha
# Texto longo e aleatório. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
DB_PATH=./data/cavalo-bike.db
FUSO=America/Sao_Paulo
# Só necessário se o frontend rodar em outro endereço
CORS_ORIGIN=
